# Copy to .env and fill in. Only the PUBLISHABLE key belongs here:
# the service-role key must never be in this repo or in the front end (PRD section 12).

# Supabase (optional during development: the app falls back to src/data/studios.json)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public site URL, used for canonical links, share tags and sitemap.xml
VITE_SITE_URL=

# External submission / correction form (FR-13), e.g. a Google Form or Tally link
VITE_SUBMISSION_FORM_URL=

# Official arkaiv email for the 404 page's "Laporkan" button (default directory.arkaiv@gmail.com)
VITE_CONTACT_EMAIL=

# Arkaiv: Apache config for shared hosting (PRD section 12).
# Assumes the site is served from the domain root. If the host does not run
# Apache (PRD decision 2), translate these rules for that server.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (AutoSSL). Remove if the host already redirects.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Prerendered pages: /studio/<slug> -> /studio/<slug>/index.html, without a
  # trailing-slash redirect, so the URLs printed as QR codes never change.
  DirectorySlash Off
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Real files are served as they are.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Everything else is a client-side route (e.g. a studio added after the last build).
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets never change: cache for a year.
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must always be revalidated so new data and builds show up.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
